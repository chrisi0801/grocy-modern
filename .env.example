# Copy to .env and adjust. docker compose reads this file automatically.

# Port on the host; Grocy is then reachable at http://<host>:9283
GROCY_PORT=9283

# Timezone - important, Grocy uses PHP's timezone for all due dates
TZ=Europe/Vienna

# Language and currency
GROCY_DEFAULT_LOCALE=de
GROCY_CURRENCY=EUR

# Only needed when pulling a pre-built image instead of building locally,
# e.g. ghcr.io/chrisi0801/grocy-modern:latest
#GROCY_IMAGE=grocy-modern:local
